# Vite: safe to expose the PUBLIC OAuth client ID to browsers
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Vercel API: server-side only (NEVER prefix these with VITE_)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com
GH_OWNER=your-github-username-or-org
GH_REPO=coding-club-content
GH_BRANCH=main
GH_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN
