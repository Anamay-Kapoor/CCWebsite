# Vercel API: server-side only (NEVER prefix these with REACT_APP_)
# Fine-grained token: repository Anamay-Kapoor/CCWebsite, permission "Contents: Read and write".
GH_TOKEN=github_pat_REPLACE_WITH_YOUR_TOKEN
# The database is always the `content` branch of Anamay-Kapoor/CCWebsite.

# Admin login (server-side only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
